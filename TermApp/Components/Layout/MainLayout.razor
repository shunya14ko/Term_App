@inherits LayoutComponentBase

<div class="page d-flex min-vh-100">
    <aside class="sidebar bg-light border-end" style="width:220px">
        <NavMenu />
    </aside>

    <main class="flex-grow-1">
        <div class="top-row px-4 py-2 border-bottom d-flex justify-content-end">
            <a class="btn btn-link" href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content p-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
