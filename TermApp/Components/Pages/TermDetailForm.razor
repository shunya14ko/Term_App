@page "/detailform/{id:long}"
@using TermApp.Service.Repository
@using TermApp.Models
@inject ICrudRepository<Term> TermRepo
@inject ICrudRepository<Note> NoteRepo
@inject ICrudRepository<Group> GroupRepo
@inject NavigationManager Nav

<PageHeader Title="■詳細内容">
    <Actions>
        <NavLink class="btn btn-outline-secondary" href="/term">
            一覧に戻る
        </NavLink>
    </Actions>
</PageHeader>

<div class="container-fluid py-4">
    @if (_loading)
    {
        <div>読み込み中...</div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (_item is null)
    {
        <div class="alert alert-warning">データが見つかりません。</div>
    }
    else
    {

        <div class="mb-3">
            <label class="form-label">ID</label>
            <input class="form-control form-control-lg" readonly value="@_item.Id" />
        </div>

        <div class="mb-3">
            <label class="form-label">名称</label>
            <input class="form-control form-control-lg" readonly value="@_item.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">作成日</label>
            <input class="form-control form-control-lg" readonly value="@_item.CreatedAt.ToString("yyyy-MM-dd HH:mm")" />
        </div>

        <div class="mb-2">
            <label class="form-label">内容</label>
            <textarea class="form-control form-control-lg textarea-formatt" readonly>@(_note?.Content ?? "")</textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">グループ</label>
            <input class="form-control form-control-lg" readonly
                   value="@(_group?.Name ?? "（未選択）")" />
        </div>

        <div class="text-muted">
            最終更新: @(_note is null ? "—" : _note.UpdatedAt.ToString("yyyy-MM-dd HH:mm"))
        </div>
    }
</div>

@code {
    [Parameter] public long Id { get; set; }
    private Term? _item;
    private Note? _note;
    private bool _loading = true;
    private string? _error;
    private Group? _group;

    // Id取得を起動時に行ってくれる
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _item = null;
        _note = null;
        _group = null;

        try
        {
            _item = await TermRepo.GetByIdAsync(Id);
            _note = await NoteRepo.GetByIdAsync(Id);

            if (_item is null)
            {
                _error = "対象データが見つかりません。";
                return;
            }

            // ★ グループを取得（所属していない場合は null のまま）
            if (_item.GroupId is long gid)
            {
                _group = await GroupRepo.GetByIdAsync(gid);
            }
        }
        catch
        {
            _error = "詳細データを取得できませんでした。";
        }
        finally
        {
            _loading = false;
        }
    }

}
