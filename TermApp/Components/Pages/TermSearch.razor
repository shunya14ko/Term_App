@page "/terms/search"
@using System.Linq
@using TermApp.Models
@using TermApp.Service.Repository
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Components.Forms
@inject ICrudRepository<Term> TermRepo
@inject ICrudRepository<Group> GroupRepo
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageHeader Title="■検索画面"></PageHeader>

@if (!string.IsNullOrEmpty(_pageError))
{
    <div class="alert alert-danger">@_pageError</div>
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">

            <div class="col-12 col-md-5">
                <label class="form-label">キーワード</label>
                <input class="form-control"
                       placeholder="名称で部分一致検索"
                       @bind-value="_keyword"
                       @bind-value:event="oninput"
                       @bind-value:after="ApplyFilter" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label">グループ</label>
                <select class="form-select"
                        @bind="_selectedGroupId"
                        @bind:after="ApplyFilter">
                    <option value="">（未選択）</option>
                    @foreach (var g in _groups)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label">作成日～</label>
                <InputDate @bind-Value="_fromDate"
                           @bind-Value:after="ApplyFilter"
                           class="form-control" />
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label">～作成日</label>
                <InputDate @bind-Value="_toDate"
                           @bind-Value:after="ApplyFilter"
                           class="form-control" />
            </div>

            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary" @onclick="ApplyFilter">
                    <i class="bi bi-search"></i> 検索
                </button>
                <button class="btn btn-outline-secondary" @onclick="ClearFilter">
                    クリア
                </button>
            </div>
        </div>
    </div>
</div>

@if (_loading)
{
    <p>Loading...</p>
}
else
{
    <QuickGrid TGridItem="Term"
               Items="_filtered.AsQueryable()"
               class="table table-hover table-striped table-bordered align-middle my-grid"
               Pagination="@_paginationState">

        <PropertyColumn Title="No" Property="@(p => p.Id)" Sortable="true" />
        <PropertyColumn Title="名称" Property="@(p => p.Name)" Sortable="true" />

        <TemplateColumn Title="作成日" Context="term">
            @term.CreatedAt.ToString("yyyy-MM-dd")
        </TemplateColumn>

        <TemplateColumn Title="詳細" Context="term">
            <NavLink class="btn btn-sm btn-primary w-100 d-block"
                     href="@($"/detailform/{term.Id}")">
                詳細はこちら
            </NavLink>
        </TemplateColumn>
    </QuickGrid>

    <div class="mt-2 paginator-fixed">
        <div class="paginator-inner">
            <Paginator State="@_paginationState" />
        </div>
    </div>
}

@code {
    private string? _pageError;
    private string _keyword = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private List<Term> _items = new();
    private List<Term> _filtered = new();
    private List<Group> _groups = new();
    private bool _loading = true;
    private long? _selectedGroupId;

    private PaginationState _paginationState = new() { ItemsPerPage = 10 };

    // 画面はTerm同様初期ページあり
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = (await TermRepo.GetAllAsync()).ToList();
            _groups = (await GroupRepo.GetAllAsync())
                            .OrderBy(g => g.Name)
                            .ToList();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _pageError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // フィルターを適用して表示更新
    private void ApplyFilter()
    {
        IEnumerable<Term> q = _items;

        if (!string.IsNullOrWhiteSpace(_keyword))
            q = q.Where(t => (t.Name ?? string.Empty)
                .Contains(_keyword, StringComparison.OrdinalIgnoreCase));

        if (_fromDate.HasValue)
            q = q.Where(t => t.CreatedAt.Date >= _fromDate.Value.Date);

        if (_toDate.HasValue)
            q = q.Where(t => t.CreatedAt.Date <= _toDate.Value.Date);

        if (_selectedGroupId.HasValue && _selectedGroupId.Value > 0)
            q = q.Where(t => t.GroupId == _selectedGroupId.Value);

        _filtered = q.OrderByDescending(t => t.Id).ToList();
        StateHasChanged();
    }

    // フィルターをクリアして表示更新
    private void ClearFilter()
    {
        _fromDate = null;
        _fromDate = null;
        _toDate = null;
        _selectedGroupId = null;
        ApplyFilter();
    }

    private async Task DeleteAsync(long id)
    {
        await TermRepo.DeleteAsync(id);
        _items = (await TermRepo.GetAllAsync()).ToList();
        ApplyFilter();
    }
}
