@page "/terms/new"
@using TermApp.Service.Ripository
@inject ICrudRepository<Term> Repo
@inject NavigationManager Nav

<h3>条件の新規作成</h3>

<EditForm Model="_model" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">名前</label>
        <InputText class="form-control" @bind-Value="_model.Name" />
    </div>

    <button class="btn btn-primary" type="submit">保存</button>
    <button class="btn btn-link" type="button" @onclick="@(() => Nav.NavigateTo("/terms"))">戻る</button>
</EditForm>

@code {
    private Term _model = new() { CreatedAt = DateTime.UtcNow };

    private async Task Save()
    {
        await Repo.AddAsync(_model);
        Nav.NavigateTo("/terms");
    }
}
