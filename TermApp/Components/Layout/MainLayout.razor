@inherits LayoutComponentBase
@inject NavigationManager Nav

@code {
    // この配列に“全画面にしたいパス”を記述
    private static readonly string[] FullBleedRoutes = ["/"];
    private bool IsFullBleed => FullBleedRoutes.Contains(new Uri(Nav.Uri).AbsolutePath, StringComparer.OrdinalIgnoreCase);
}

<div class="layout d-flex min-vh-100">
    <aside class="sidebar bg-white border-end" style="width:220px">
        <NavMenu />
    </aside>

    <main class="flex-grow-1 d-flex flex-column">
        <div class="top-row @(IsFullBleed ? "d-none" : "px-4 py-2")"></div>

        <!-- ★ New/Home は余白0＋高さ100vh＋ページスクロール禁止 -->
        <article class="content @(IsFullBleed ? "content--flush content--vh" : "content--default") flex-grow-1">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
