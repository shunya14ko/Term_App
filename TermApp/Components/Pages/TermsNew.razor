@page "/terms/new"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using TermApp.Models
@using TermApp.Service.Repository
@inject ICrudRepository<TermApp.Models.Term> TermRepo
@inject ICrudRepository<Group> GroupRepo
@inject ICrudRepository<Note> NoteRepo
@inject NavigationManager Nav

<PageHeader Title="■単語追加">
    <Actions>
        <NavLink class="btn btn-outline-secondary" href="/term">
            単語一覧に戻る
        </NavLink>
    </Actions>
</PageHeader>

<div class="fullpage-form d-flex flex-column h-100">
    <div class="mx-auto form-max w-100">
        @if (!string.IsNullOrEmpty(_pageError))
        {
            <div class="alert alert-danger">@_pageError</div>
        }

        <div class="card shadow-sm flex-grow-1">
            <div class="card-body d-flex flex-column overflow-hidden">
                <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="NewTermForm" class="d-flex flex-column flex-grow-1">
                    <DataAnnotationsValidator />

                    <ValidationSummary class="alert alert-warning" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">名前（必須）</label>
                        <InputText class="form-control form-control-lg" placeholder="例）トランザクション"
                                   @bind-Value="_form.Name" />
                        <div class="form-text">用語の正式名称を入力してください（100文字まで）。</div>
                        <ValidationMessage For="@(() => _form.Name)" />
                    </div>

                    <div class="mb-3 d-flex flex-column flex-grow-1 min-h">
                        <label class="form-label fw-semibold">説明</label>
                        <InputTextArea class="form-control form-control-lg textarea-formatt"
                                       placeholder="用語の説明やメモを自由に記入"
                                       @bind-Value="_form.Note" />
                        <div class="form-text">改行や長文OK（最大2000文字）。</div>
                        <ValidationMessage For="@(() => _form.Note)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">グループ</label>
                        <InputSelect class="form-select form-select-lg" TValue="long?" @bind-Value="_form.GroupId">
                            <option value="">（未選択）</option>
                            @foreach (var g in _groups)
                            {
                                <option value="@g.Id">@g.Name</option>
                            }
                        </InputSelect>
                        <div class="form-text">任意。分類したい場合に選択してください。</div>
                        <ValidationMessage For="@(() => _form.GroupId)" />
                    </div>

                    <!-- ★ ボタンは下に固定される感じで -->
                    <div class="mt-auto d-flex gap-2 pt-2">
                        <button class="btn btn-primary btn-lg px-4" type="submit" disabled="@_saving">
                            @(_saving ? "保存中…" : "保存")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private sealed class TermFormModel
    {
        [Required(ErrorMessage = "名称は必須です。")]
        [StringLength(100)]
        public string Name { get; set; } = string.Empty;

        [StringLength(2000)]
        public string? Note { get; set; }

        public long? GroupId { get; set; }
    }

    private TermFormModel _form = new();
    private List<Group> _groups = new();
    private string? _pageError;
    private bool _saving;

    // 初期化処理でグループ一覧を取得
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = await GroupRepo.GetAllAsync();
            _groups = items?.OrderBy(g => g.Name).ToList() ?? new();
        }
        catch (Exception ex)
        {
            _pageError = "グループ一覧の取得に失敗しました。";
            Console.WriteLine(ex);
        }
    }

    // 保存処理
    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;

        try
        {
            var term = new TermApp.Models.Term
            {
                Name = _form.Name.Trim(),
                GroupId = _form.GroupId,
                CreatedAt = DateTime.UtcNow
            };
            await TermRepo.AddAsync(term);

            if (!string.IsNullOrWhiteSpace(_form.Note))
            {
                var note = new TermApp.Models.Note
                {
                    TermId = term.Id,
                    Content = _form.Note.Trim(),
                    UpdatedAt = DateTime.UtcNow
                };
                await NoteRepo.AddAsync(note);
            }

            Nav.NavigateTo("/terms");
        }
        catch (Exception ex)
        {
            _pageError = $"保存に失敗しました。時間をおいて再度お試しください。{ex}";
        }
        finally
        {
            _saving = false;
        }
    }
}

