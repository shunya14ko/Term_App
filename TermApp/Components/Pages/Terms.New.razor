@page "/terms/new"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using TermApp.Models
@using TermApp.Service.Repository

@inject ICrudRepository<TermApp.Models.Term> TermRepo
@inject ICrudRepository<Group> GroupRepo
@inject ICrudRepository<Note> NoteRepo
@inject NavigationManager Nav

<PageTitle>用語作成</PageTitle>

<h1 class="mb-3">I用語追加</h1>

@if (!string.IsNullOrEmpty(_pageError))
{
    <div class="alert alert-danger">@_pageError</div>
}

<EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="NewTermForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">名前（必須）</label>
        <InputText class="form-control" @bind-Value="_form.Name" />
        <ValidationMessage For="@(() => _form.Name)" />
    </div>

    <div class="mb-3">
        <label class="form-label">説明</label>
        <InputTextArea class="form-control" rows="5" @bind-Value="_form.Note" />
    </div>

    <div class="mb-3">
        <label class="form-label">グループ</label>
        <InputSelect class="form-select" TValue="long?" @bind-Value="_form.GroupId">
            <option value="">（未選択）</option>
            @foreach (var g in _groups)
            {
                <option value="@g.Id">@g.Name</option>
            }
        </InputSelect>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit" disabled="@_saving">保存</button>
        <NavLink class="btn btn-secondary" href="/">キャンセル</NavLink>
    </div>
</EditForm>

@code {
    // 画面用フォームモデル（エンティティTermと衝突しない名前にする）
    private sealed class TermFormModel
    {
        [Required(ErrorMessage = "名称は必須です。")]
        [StringLength(100)]
        public string Name { get; set; } = string.Empty;

        [StringLength(2000)]
        public string? Note { get; set; }

        // 未選択OKにするため nullable
        public long? GroupId { get; set; }
    }

    private TermFormModel _form = new();
    private List<Group> _groups = new();
    private string? _pageError;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = await GroupRepo.GetAllAsync();
            _groups = items?.OrderBy(g => g.Name).ToList() ?? new();
        }
        catch (Exception ex)
        {
            _pageError = "グループ一覧の取得に失敗しました。";
            Console.WriteLine(ex);
        }
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;

        try
        {
            // 1) Term を作成・保存（エンティティは完全修飾名で明示）
            var term = new TermApp.Models.Term
            {
                Name      = _form.Name.Trim(),
                GroupId   = _form.GroupId,
                CreatedAt = DateTime.UtcNow
            };
            await TermRepo.AddAsync(term);

            // 2) 説明があれば Note テーブルへ
            if (!string.IsNullOrWhiteSpace(_form.Note))
            {
                var note = new Note
                {
                    TermId    = term.Id,
                    Content   = _form.Note.Trim(),
                    UpdatedAt = DateTime.UtcNow
                };
                await NoteRepo.AddAsync(note);
            }

            // 3) 一覧へ戻る
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _pageError = "保存に失敗しました。時間をおいて再度お試しください。";
            Console.WriteLine(ex);
        }
        finally
        {
            _saving = false;
        }
    }
}
