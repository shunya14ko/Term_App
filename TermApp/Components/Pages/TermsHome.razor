@page "/term"
@using Microsoft.AspNetCore.Components.QuickGrid
@using TermApp.Models
@using TermApp.Service.Repository
@inject ICrudRepository<Term> TermRepo
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageHeader Title="■単語一覧"></PageHeader>

@if (!string.IsNullOrEmpty(_pageError))
{
    <div class="alert alert-danger">@_pageError</div>
}

@if (_loading)
{
    <p>Loading...</p>
}
else
{
    <QuickGrid TGridItem="Term"
               Items="_items.AsQueryable()"
               class="table table-hover table-striped table-bordered align-middle my-grid"
               Pagination="@_paginationState">

        <PropertyColumn Title="No" Property="@(p => p.Id)" Sortable="true" />
        <PropertyColumn Title="名称" Property="@(p => p.Name)" Sortable="true" />
        <PropertyColumn Title="作成日" Property="@(p => p.CreatedAt)" Sortable="true" Format="yyyy-MM-dd" />

        <TemplateColumn Title="詳細" Context="term">
            <NavLink class="btn btn-sm btn-secondary w-100 d-block"
                     href="@($"/detailform/{term.Id}")">
                詳細
            </NavLink>
        </TemplateColumn>

        <TemplateColumn Title="編集" Context="term">
            <NavLink class="btn btn-sm btn-primary w-100 d-block"
                     href="@($"/terms/edit/{term.Id}")">
                編集
            </NavLink>
        </TemplateColumn>

        <TemplateColumn Title="削除" Context="term">
            <button type="button"
                    class="btn btn-sm btn-danger w-100 d-block"
                    @onclick="@(() => DeleteAsync(term.Id))">
                削除
            </button>
        </TemplateColumn>
    </QuickGrid>

    <div class="mt-2 paginator-fixed">
        <div class="paginator-inner">
            <Paginator State="@_paginationState" />
        </div>
    </div>

    @if (_items.Count == 0)
    {
        <div class="alert alert-info">データがありません。「新規作成」から追加してください。</div>
    }
}

@code {
    // QuickGrid に渡すソース
    private List<Term> _items = new();
    private bool _loading = true;
    private string? _pageError;

    // QuickGrid のページング設定
    private readonly PaginationState _paginationState = new() { ItemsPerPage = 10 };

    // 削除ボタンのイベント
    private async Task DeleteAsync(long id)
    {
        try
        {
            await TermRepo.DeleteAsync(id);
            var idTerm = _items.FindIndex(t => t.Id == id);
            if (idTerm >= 0) _items.RemoveAt(idTerm);
        }
        catch (Exception ex)
        {
            _pageError = $"削除に失敗しました。{ex}";
        }
    }

    // 用語一覧のロード
    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var list = await TermRepo.GetAllAsync();
            _items = list?.ToList() ?? new List<Term>();
            _items = _items.OrderByDescending(t => t.CreatedAt).ToList();
        }
        catch (Exception ex)
        {
            _pageError = "データの取得に失敗しました。時間をおいて再度お試しください。";
            Console.WriteLine(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    // 詳細ページへ遷移
    private void OpenDetail(long id) => Nav.NavigateTo($"/detailform/{id}");

    // 編集ページへ遷移
    private void GoEdit(long id) => Nav.NavigateTo($"/terms/edit/{id}");

    // 新規作成ページへ遷移
    private void GoNew() => Nav.NavigateTo("/terms/new");
}

